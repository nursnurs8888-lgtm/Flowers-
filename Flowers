                    <div class="flex flex-wrap gap-2 pt-1">
                        <span class="px-3 py-1.5 bg-stone-800 rounded-lg text-xs font-semibold text-white">Kaspi QR / Red</span>
                        <span class="px-3 py-1.5 bg-stone-800 rounded-lg text-xs font-semibold text-white">Visa / Mastercard</span>
                        <span class="px-3 py-1.5 bg-stone-800 rounded-lg text-xs font-semibold text-white">Қолма-қол</span>
                    </div>
                </div>
            </div>

            <div class="pt-8 text-center text-xs text-stone-500">
                &copy; 2026 ARU ROSE — Раушан гүлдер дүкені. Барлық құқықтар қорғалған.
            </div>
        </div>
    </footer>

    <!-- Себет және тапсырыс беру модалы (Shopping Cart & Checkout Modal) -->
    <div id="cart-modal" class="fixed inset-0 z-50 hidden">
        <!-- Фонды қараңғылау -->
        <div onclick="toggleCartModal(false)" class="absolute inset-0 bg-charcoal/60 backdrop-blur-sm transition-opacity"></div>
        
        <!-- Модал терезесі -->
        <div class="relative z-10 max-w-lg w-full ml-auto h-full bg-white shadow-2xl flex flex-col">
            <!-- Модал тақырыбы -->
            <div class="px-6 py-5 border-b border-stone-200 flex items-center justify-between bg-creamBg">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-bag-shopping text-roseDeep text-xl"></i>
                    <h3 class="font-serif text-2xl font-bold text-charcoal">Сіздің себетіңіз</h3>
                </div>
                <button onclick="toggleCartModal(false)" class="w-9 h-9 rounded-full bg-white hover:bg-stone-100 text-stone-600 flex items-center justify-center shadow-sm">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Себет ішіндегі тауарлар мен форма -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                <!-- Таңдалған гүлдер тізімі -->
                <div id="cart-items-container" class="space-y-4">
                    <!-- JS арқылы толтырылады -->
                </div>

                <!-- Тапсырыс беру формасы (тек себетте тауар болса көрінеді) -->
                <form id="order-form" onsubmit="submitOrder(event)" class="space-y-4 pt-4 border-t border-stone-200 hidden">
                    <h4 class="font-bold text-charcoal text-base">Жеткізу мәліметтері</h4>
                    
                    <div>
                        <label class="block text-xs font-semibold text-stone-600 mb-1">Есіміңіз *</label>
                        <input type="text" id="customer-name" required placeholder="Мысалы: Арман" 
                               class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-roseDeep focus:ring-2 focus:ring-roseDeep/20 outline-none text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-600 mb-1">Телефон нөміріңіз (WhatsApp) *</label>
                        <input type="tel" id="customer-phone" required placeholder="+7 (700) 000-00-00" 
                               class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-roseDeep focus:ring-2 focus:ring-roseDeep/20 outline-none text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-600 mb-1">Жеткізу мекенжайы *</label>
                        <input type="text" id="customer-address" required placeholder="Көше, үй, пәтер нөмірі" 
                               class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-roseDeep focus:ring-2 focus:ring-roseDeep/20 outline-none text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-600 mb-1">Ашық хатқа (открытка) жазылатын тілек</label>
                        <textarea id="customer-note" rows="2" placeholder="Құттықтау мәтіні (міндетті емес)" 
                                  class="w-full px-4 py-2.5 rounded-xl border border-stone-300 focus:border-roseDeep focus:ring-2 focus:ring-roseDeep/20 outline-none text-sm"></textarea>
                    </div>

                    <div class="bg-roseSoft/70 p-4 rounded-2xl flex items-center justify-between">
                        <span class="text-sm font-medium text-stone-700">Жалпы сомасы:</span>
                        <span id="cart-total-price" class="text-xl font-bold text-roseDeep">0 ₸</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        <button type="submit" class="w-full py-3.5 px-4 bg-roseDeep hover:bg-roseRich text-white font-semibold rounded-xl shadow-lg transition text-sm">
                            Тапсырыс беру
                        </button>
                        <button type="button" onclick="sendOrderViaWhatsApp()" class="w-full py-3.5 px-4 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl shadow-lg transition text-sm flex items-center justify-center space-x-2">
                            <i class="fa-brands fa-whatsapp text-lg"></i>
                            <span>WhatsApp арқылы</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Хабарлама терезесі (Toast Notification) -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 bg-charcoal text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center space-x-3 border border-stone-700">
        <i class="fa-solid fa-circle-check text-amber-400 text-lg"></i>
        <span id="toast-message" class="text-sm font-medium">Гүл шоғы себетке қосылды!</span>
    </div>

    <!-- Тапсырыс сәтті қабылданды модалы -->
    <div id="success-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
        <div onclick="closeSuccessModal()" class="absolute inset-0 bg-charcoal/70 backdrop-blur-sm"></div>
        <div class="relative z-10 bg-white rounded-3xl max-w-md w-full p-8 text-center shadow-2xl space-y-5">
            <div class="w-16 h-16 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto text-3xl">
                <i class="fa-solid fa-check"></i>
            </div>
            <h3 class="font-serif text-3xl font-bold text-charcoal">Тапсырысыңыз қабылданды!</h3>
            <p class="text-stone-600 text-sm leading-relaxed">
                Рақмет! Біздің менеджер 5 минут ішінде сізбен байланысып, тапсырысты растайды.
            </p>
            <button onclick="closeSuccessModal()" class="w-full py-3.5 bg-roseDeep text-white font-semibold rounded-xl hover:bg-roseRich transition">
                Жақсы
            </button>
        </div>
    </div>

    <script>
        // Раушан гүлдер каталогының деректері
        const products = [
            {
                id: 1,
                name: "101 Қызыл раушан «Патшайым»",
                category: "vip",
                price: 85000,
                desc: "Биіктігі 70 см Эквадор қызыл раушандары. Нағыз махаббат символы.",
                badge: "Хит",
                image: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80"
            },
            {
                id: 2,
                name: "Ақ раушандар шоғы «Аққу» (25 дана)",
                category: "classic",
                price: 24500,
                desc: "Нәзік әрі кіршіксіз тазалықты білдіретін 25 голландиялық ақ раушан.",
                badge: "Нәзік",
                image: "https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=800&q=80"
            },
            {
                id: 3,
                name: "Қызғылт пион тәрізді раушандар (19 дана)",
                category: "classic",
                price: 29000,
                desc: "Ерекше хош иісті О'Хара сұрыпты пион тәрізді раушандар топтамасы.",
                badge: "Тренд",
                image: "https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&w=800&q=80"
            },
            {
                id: 4,
                name: "Барқыт қораптағы раушандар",
                category: "box",
                price: 32000,
                desc: "Арнайы ылғал сақтағыш губкаға орналастырылған 21 раушан. Ваза қажет етпейді.",
                badge: "Сәнді",
                image: "https://images.unsplash.com/photo-1548094990-c16ca90f1f0d?auto=format&fit=crop&w=800&q=80"
            },
            {
                id: 5,
                name: "51 Голландиялық микс раушан",
                category: "vip",
                price: 46000,
                desc: "Қызыл, қызғылт және крем түсті раушандардың үйлесімді композициясы.",
                badge: "-10%",
                image: "https://images.unsplash.com/photo-1562690868-60bbe7293e94?auto=format&fit=crop&w=800&q=80"
            },
            {
                id: 6,
                name: "Көк раушандар «Ғарыш сыры» (15 дана)",
                category: "box",
                price: 27500,
                desc: "Ерекше әсер қалдырғысы келетін жандар үшін сирек кездесетін көк раушандар.",
                badge: "Эксклюзив",
                image: "https://images.unsplash.com/photo-1582794543139-8ac9cb0f7b11?auto=format&fit=crop&w=800&q=80"
            }
        ];

        // Себет күйі (State)
        let cart = [];

        // Дүкеннің WhatsApp нөмірі
        const SHOP_WHATSAPP = "77001234567";

        // Бағаны теңгемен форматтау
        function formatPrice(price) {
            return price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + " ₸";
        }

        // Каталогты экранға шығару
        function renderProducts(filter = 'all') {
            const grid = document.getElementById('products-grid');
            grid.innerHTML = '';

            const filtered = filter === 'all' 
                ? products 
                : products.filter(p => p.category === filter);

            filtered.forEach(product => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-3xl overflow-hidden border border-stone-200/70 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group";
                card.innerHTML = `
                    <div class="relative aspect-[4/3] overflow-hidden bg-roseSoft">
                        <img src="${product.image}" 
                             onerror="this.src='https://placehold.co/600x450/9F1239/FFF1F2?text=${encodeURIComponent(product.name)}'"
                             alt="${product.name}" 
                             class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        ${product.badge ? `<span class="absolute top-4 left-4 bg-charcoal/85 backdrop-blur-md text-amber-300 text-xs font-bold px-3 py-1 rounded-full">${product.badge}</span>` : ''}
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <h3 class="font-serif text-2xl font-bold text-charcoal group-hover:text-roseDeep transition">${product.name}</h3>
                            <p class="text-stone-500 text-sm mt-2 leading-relaxed">${product.desc}</p>
                        </div>
                        <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
                            <div>
                                <span class="text-xs text-stone-400 block">Бағасы</span>
                                <span class="text-xl font-bold text-roseDeep">${formatPrice(product.price)}</span>
                            </div>
                            <button onclick="addToCart(${product.id})" class="px-5 py-3 bg-roseSoft hover:bg-roseDeep text-roseDeep hover:text-white font-semibold rounded-2xl transition flex items-center space-x-2 active:scale-95">
                                <i class="fa-solid fa-plus text-xs"></i>
                                <span class="text-sm">Себетке</span>
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Категория бойынша сүзу
        function filterProducts(category, btnElement) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-roseDeep', 'text-white', 'shadow-md');
                btn.classList.add('bg-white', 'text-stone-700', 'border', 'border-stone-200');
            });
            btnElement.classList.remove('bg-white', 'text-stone-700', 'border', 'border-stone-200');
            btnElement.classList.add('bg-roseDeep', 'text-white', 'shadow-md');
            
            renderProducts(category);
        }

        // Себетке қосу
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            updateCartUI();
            showToast(`«${product.name}» себетке қосылды`);
        }

        // Санын өзгерту
        function changeQty(productId, delta) {
            const index = cart.findIndex(item => item.id === productId);
            if (index === -1) return;

            cart[index].qty += delta;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartUI();
        }

        // Себет интерфейсін жаңарту
        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items-container');
            const orderForm = document.getElementById('order-form');
            const totalPriceEl = document.getElementById('cart-total-price');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            badge.textContent = totalQty;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 space-y-3">
                        <div class="w-16 h-16 rounded-full bg-roseSoft text-roseDeep flex items-center justify-center mx-auto text-2xl">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <h4 class="font-bold text-charcoal text-lg">Себет әзірге бос</h4>
                        <p class="text-sm text-stone-500">Каталогтан өзіңізге ұнаған раушан шоғын таңдаңыз.</p>
                    </div>
                `;
                orderForm.classList.add('hidden');
            } else {
                container.innerHTML = cart.map(item => `
                    <div class="flex items-center justify-between bg-creamBg p-3.5 rounded-2xl border border-stone-200/70">
                        <div class="flex items-center space-x-3">
                            <img src="${item.image}" alt="${item.name}" class="w-16 h-16 rounded-xl object-cover">
                            <div>
                                <h5 class="font-bold text-sm text-charcoal line-clamp-1">${item.name}</h5>
                                <span class="text-roseDeep font-bold text-sm">${formatPrice(item.price)}</span>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 bg-white px-2.5 py-1.5 rounded-xl border border-stone-200">
                            <button onclick="changeQty(${item.id}, -1)" class="w-6 h-6 text-stone-600 hover:text-roseDeep font-bold">-</button>
                            <span class="text-sm font-bold w-5 text-center">${item.qty}</span>
                            <button onclick="changeQty(${item.id}, 1)" class="w-6 h-6 text-stone-600 hover:text-roseDeep font-bold">+</button>
                        </div>
                    </div>
                `).join('');

                orderForm.classList.remove('hidden');
                totalPriceEl.textContent = formatPrice(totalPrice);
            }
        }

        // Себет модалын ашу/жабу
        function toggleCartModal(show) {
            const modal = document.getElementById('cart-modal');
            if (show) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // Сайт арқылы тапсырысты жіберу
        function submitOrder(e) {
            e.preventDefault();
            if (cart.length === 0) return;

            toggleCartModal(false);
            cart = [];
            updateCartUI();
            document.getElementById('order-form').reset();
            document.getElementById('success-modal').classList.remove('hidden');
        }

        // WhatsApp арқылы дайын тапсырысты жіберу
        function sendOrderViaWhatsApp() {
            if (cart.length === 0) return;

            const name = document.getElementById('customer-name').value || "Көрсетілмеген";
            const phone = document.getElementById('customer-phone').value || "Көрсетілмеген";
            const address = document.getElementById('customer-address').value || "Көрсетілмеген";
            const note = document.getElementById('customer-note').value;

            let itemsText = cart.map((item, idx) => 
                `${idx + 1}. ${item.name} — ${item.qty} дана (${formatPrice(item.price * item.qty)})`
            ).join('%0A');

            const total = formatPrice(cart.reduce((sum, item) => sum + (item.price * item.qty), 0));

            let message = `Сәлеметсіз бе! *ARU ROSE* дүкенінен тапсырыс бергім келеді:%0A%0A` +
                          `*Таңдалған гүлдер:*%0A${itemsText}%0A%0A` +
                          `*Жалпы сомасы:* ${total}%0A` +
                          `*Есімі:* ${name}%0A` +
                          `*Телефон:* ${phone}%0A` +
                          `*Мекенжайы:* ${address}`;

            if (note) {
                message += `%0A*Открытка мәтіні:* ${note}`;
            }

            window.open(`https://wa.me/${SHOP_WHATSAPP}?text=${message}`, '_blank');
        }

        // Тікелей WhatsApp-қа жазу
        function openQuickWhatsApp() {
            const text = encodeURIComponent("Сәлеметсіз бе! Раушан гүлдер шоғы бойынша кеңес алғым келеді.");
            window.open(`https://wa.me/${SHOP_WHATSAPP}?text=${text}`, '_blank');
        }

        // Сәтті тапсырыс модалын жабу
        function closeSuccessModal() {
            document.getElementById('success-modal').classList.add('hidden');
        }

        // Хабарлама (Toast) көрсету
        let toastTimeout;
        function showToast(text) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = text;
            toast.classList.remove('translate-y-24', 'opacity-0');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 2500);
        }

        // Бет жүктелгенде каталог пен себетті іске қосу
        window.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            updateCartUI();
        });
    </script>
</body>
</html>
